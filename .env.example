# ============================================================================
# Environment template -- copy to .env and adjust for your machine.
#   cp .env.example .env
# docker-compose.yml ships with these same values as defaults, so the project
# runs out of the box without a .env file at all.
# ============================================================================

# --- PostgreSQL container credentials --------------------------------------
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=retail_secret
POSTGRES_DB=retail_inventory_db

# --- Host-side connection --------------------------------------------------
# 5433 avoids colliding with a PostgreSQL already installed on the host.
DB_HOST=localhost
DB_PORT=5433

# --- SQLAlchemy DSN consumed by src/etl_pipeline.py ------------------------
RETAIL_DB_DSN=postgresql+psycopg2://retail_admin:retail_secret@localhost:5433/retail_inventory_db

# --- Simulation parameters -------------------------------------------------
SIM_DAYS=60
SIM_SEED=20261012
